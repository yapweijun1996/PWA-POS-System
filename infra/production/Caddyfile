{
  email {$ACME_EMAIL}
  admin off
}

{$APP_HOST} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000"
    -Server
  }
  request_body {
    max_size 1MB
  }
  reverse_proxy app:3000 {
    transport http {
      dial_timeout 5s
      response_header_timeout 35s
    }
  }
  # Access logs are intentionally disabled. The application emits redacted events.
}

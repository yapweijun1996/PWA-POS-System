# Supply credentials through your environment. Never put them in VITE_* variables.
DATABASE_URL=postgresql://counter_pos_app@127.0.0.1:55432/counter_pos_dev
# Demo/dev may use a separate non-owner URL when password authentication is enabled.
# RUNTIME_DATABASE_URL=
PORT=3000
APP_ORIGIN=http://localhost:3000
DEMO_MODE=1
# Production requires HTTPS, DEMO_MODE=0 and a random >=32-character signing secret.
# PERMIT_SECRET=
# File-backed production secrets are exclusive with the corresponding value.
# DATABASE_URL_FILE=/run/secrets/runtime_database_url
# PERMIT_SECRET_FILE=/run/secrets/permit_secret
# Review legacy SQL before a one-time checksum baseline during an upgrade.
# BASELINE_LEGACY_MIGRATIONS=1
